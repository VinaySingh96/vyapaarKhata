{
  "name": "vyapaarkhata-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' run build",
    "dev:server": "pnpm --filter @vyapaarkhata/server dev",
    "dev:web": "pnpm --filter @vyapaarkhata/web dev",
    "test": "vitest run",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
