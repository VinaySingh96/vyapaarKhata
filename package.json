{
  "name": "vyapaarkhata-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' run build",
    "build:server": "pnpm --filter @vyapaarkhata/domain build && pnpm --filter @vyapaarkhata/db build && pnpm --filter @vyapaarkhata/server build",
    "build:central": "pnpm --filter @vyapaarkhata/domain build && pnpm --filter @vyapaarkhata/central-server build",
    "build:web": "pnpm --filter @vyapaarkhata/domain build && pnpm --filter @vyapaarkhata/web build",
    "db:migrate": "node scripts/migrate-pg.js",
    "dev:server": "pnpm --filter @vyapaarkhata/server dev",
    "dev:central": "pnpm --filter @vyapaarkhata/central-server dev",
    "dev:web": "pnpm --filter @vyapaarkhata/web dev",
    "dev:local": "node scripts/dev-local.js",
    "tenant:delete": "node scripts/delete-tenant.js",
    "dev:patel:server": "PORT=4002 CENTRAL_TENANT_ID=00000000-0000-0000-0000-000000000001 DATABASE_URL=postgresql://localhost:5432/vyapaarkhata_patel node apps/server/dist/index.js",
    "dev:patel:web": "vite apps/web --config apps/web/vite.patel.config.js",
    "dev:jewellery:server": "PORT=4003 CENTRAL_TENANT_ID=00000000-0000-0000-0000-000000000002 DATABASE_URL=postgresql://localhost:5432/vyapaarkhata_jewellery node apps/server/dist/index.js",
    "dev:jewellery:web": "vite apps/web --config apps/web/vite.jewellery.config.js",
    "test": "vitest run",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.34.5"
}
