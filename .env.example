# Environment Configuration Example for vyapaarKhata (macOS Local Dev)
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Database Configuration (PostgreSQL for Laptop/Mac)
DB_DRIVER=postgres
DATABASE_URL=postgresql://localhost:5432/vyapaarkhata_dev
TEST_DATABASE_URL=postgresql://localhost:5432/vyapaarkhata_test

# SQLite Configuration (For Embedded / Tablet / Test Mode)
SQLITE_DB_PATH=./data/vyapaarkhata.sqlite
SQLITE_TEST_DB_PATH=./data/vyapaarkhata_test.sqlite

# Security & Auth Secrets (Placeholders only)
JWT_SECRET=dev-jwt-secret-placeholder-minimum-32-characters-needed
SESSION_SECRET=dev-session-secret-placeholder-minimum-32-characters

# Sync & Instance Role
IS_PRIMARY_INSTALLATION=true
INSTALLATION_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
